# Render / Resend email configuration
RESEND_API_KEY=

# Verified sender address/domain in Resend.
RESEND_FROM_EMAIL="Nettekspertene <booking@nettekspertene.com>"

# Destination address for contact form submissions.
CONTACT_RECEIVER_EMAIL="kontakt@nettekspertene.com"

# Optional: comma-separated frontend domains allowed to call the Render API.
# Leave empty to allow all origins.
CORS_ORIGIN="https://nettekspertene.com,https://www.nettekspertene.com"
